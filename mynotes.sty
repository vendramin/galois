\newtcolorbox{eqbox}[1][]
{
  boxrule=0pt,
  frame hidden,
  colback=red!5!white,
  % Keep inner horizontal padding at 0pt so the text box boundaries line up
  left=0pt, 
  right=0pt, 
  top=.3em, 
  bottom=.3em,
  beforeafter skip balanced=.4\baselineskip plus 2pt,
  % Force the box to look up and use the true document indentation
  before upper={\parindent\normalparindent}, 
  breakable,
  #1
}
\newenvironment{optional}[1][]{\begin{eqbox}[#1]}{\end{eqbox}}

