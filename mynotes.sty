% Special macro for two-line permutation
\ExplSyntaxOn
\NewDocumentCommand{\perm}{m} {
    % Count the number of digits in the input
    \int_set:Nn \l_tmpa_int { \tl_count:n {#1} }

    % Generate the identity permutation: 123...n
    \tl_set:Nn \l_identity_tl {}
    \int_step_inline:nnnn { 1 } { 1 } { \l_tmpa_int } {
        \tl_put_right:Nn \l_identity_tl { ##1 }
    }

    % Create the two-line permutation using genfrac
    \genfrac(){0pt}{0}{\l_identity_tl}{#1}
}
\ExplSyntaxOff

