\makeatletter
\newcommand{\listoflectures}{%
  \par\addvspace{3.5ex \@plus 1ex \@minus .2ex}%
  {\centering\normalfont\bfseries List of lectures\par}%
  \nobreak\vspace{2.3ex \@plus .2ex}%
  \@afterindentfalse\@afterheading
  \begingroup
    \makeatletter
    \IfFileExists{\jobname.lec}{\@input{\jobname.lec}}{}%
    \if@filesw
      \expandafter\newwrite\csname tf@lec\endcsname
      \immediate\openout\csname tf@lec\endcsname\jobname.lec\relax
    \fi
  \endgroup}

\newcounter{lecture}
\newcommand{\lecture}{%
  \refstepcounter{lecture}%
  \addcontentsline{lec}{section}{Lecture~\thelecture}%
  \marginnote{\lecturebubble{\thelecture}}[-1.9\baselineskip]%
  \ignorespaces}
\newcommand{\lecturebubble}[1]{\tikz[baseline={([yshift=.9cm]char.base)}]{\node(char)[rounded corners=7pt,
 draw=gray!15!white,line width=.7pt,fill=gray!5!white,inner xsep=7pt,inner ysep=3.5pt,
 font=\sffamily\footnotesize\color{green!30!black}]{Lecture~#1};}}
\newcommand{\graybubble}[1]{\tikz[baseline=(char.base)]{\node(char)[rounded corners=7pt,
 draw=gray!15!white,line width=.7pt,fill=gray!5!white,inner xsep=7pt,inner ysep=3.5pt,
 font=\sffamily\footnotesize\color{blue!50!red}]{#1};}}

\makeatother

%% ------------------------------------------------------------
%% Page style: running header/footer
%% ------------------------------------------------------------
\makeatletter
\newcommand{\mynotes@sectionmark}[2]{% #1 = number (may be empty), #2 = title
  \begingroup
    \protected@xdef\mynotes@mark{%
      \@ifempty{#1}{}{\noexpand\sectionname\space#1.\space#2}}%
  \endgroup
  \expandafter\mynotes@markboth\expandafter{\mynotes@mark}%
}
\newcommand{\mynotes@markboth}[1]{\markboth{#1}{#1}}
% \maketitle sets a mark of its own (short title / authors); clear it so
% that the front matter carries no running head at all.
\let\mynotes@maketitle\maketitle
\renewcommand{\maketitle}{\mynotes@maketitle\markboth{}{}}
\let\mynotes@tocwrite\@tocwrite
\def\@tocwrite#1#2{%
  \def\mynotes@a{#1}\def\mynotes@b{section}%
  \ifx\mynotes@a\mynotes@b
    \expandafter\mynotes@sectionmark\expandafter{\@secnumber}{#2}%
  \fi
  \mynotes@tocwrite{#1}{#2}}
\makeatother
 
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\nouppercase{\rightmark}}
\fancyfoot[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\setlength{\headheight}{14pt}
 
% LaTeX internals (\maketitle, \theindex, ...) switch to the "plain"
% page style on their first page.  Make it identical, so that every
% page of the document looks the same: nothing on top, page number
% alone in the lower right corner.
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}
% amsproc's \maketitle uses its own "firstpage" style (page number
% centred, series logo on top).  Same treatment.
\fancypagestyle{firstpage}{%
  \fancyhf{}
  \fancyfoot[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

